        </profile>
        <profile id="cdf9bc1e" name="Enhancement: Hateful Exhortation (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">At the start of the first battle round, select one enemy unit. Until the end of the battle, each time a model in the bearer's unit makes an attack that targets that enemy unit, on a Critical Wound, improve the Armour Penetration characteristic of that attack by 1. (Default enhancement; may be replaced with Infernal Blessing.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
