        <profile id="09eedc85" name="Enhancement: Armour of Faith (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">The bearer has the Feel No Pain 4+ ability. In addition, while the bearer is leading a unit, other models in that unit have the Feel No Pain 5+ ability. (Default enhancement; may be replaced with Saintly Relic: In your Command phase, if the bearer is not Battle-shocked and is within range of an objective marker you control, you gain one Miracle dice. In addition, while the bearer is on the battlefield, each time you gain a Miracle dice, you can re-roll that Miracle dice.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="34f1beaf" name="Lead the Righteous" hidden="false">
          <description>While this model is leading a unit, each time a model in that unit makes an attack, you can re-roll the Hit roll.</description>
        </rule>
        <rule id="4541f07f" name="Leader" hidden="false">
          <description>This model can be attached to the following unit: Battle Sisters Squad.</description>
        </rule>
        <rule id="b01f4fd0" name="Enhancement: Armour of Faith (Warlord)" hidden="false">
          <description>The bearer has the Feel No Pain 4+ ability. In addition, while the bearer is leading a unit, other models in that unit have the Feel No Pain 5+ ability. (Default enhancement; may be replaced with Saintly Relic: In your Command phase, if the bearer is not Battle-shocked and is within range of an objective marker you control, you gain one Miracle dice. In addition, while the bearer is on the battlefield, each time you gain a Miracle dice, you can re-roll that Miracle dice.)</description>
        </rule>
      </rules>
