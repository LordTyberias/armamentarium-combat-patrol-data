        </profile>
        <profile id="fe1d074e" name="Leader" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">This model can be attached to the following units: Battle Sisters Squad, Celestian Sacresants.</characteristic>
          </characteristics>
        </profile>
        <profile id="67b24d9b" name="Enhancement: Defender of the Faith (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Improve the Save characteristic of models in the bearer's unit by 1. In your Command phase, you can discard 1 Miracle dice. If you do, until the start of your next Command phase, add 1 to the Objective Control characteristic of models in the bearer's unit. (Default enhancement; may be replaced with Righteous Fury: The bearer's unit is eligible to shoot and declare a charge in a turn in which it Advanced or Fell Back. In your Command phase, you can discard 1 Miracle dice. If you do, until the end of the turn, you can re-roll Charge rolls made for the bearer's unit.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
