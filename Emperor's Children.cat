    <selectionEntry id="cp::callous-blades::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="5c45ecf7" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="856d9969" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="7d0736a9" name="Combat Patrol: Emperor's Children (Callous Blades)" hidden="false" targetId="cp-cat::callous-blades" primary="true" />
        <categoryLink id="40e09144" name="Emperor's Children" hidden="false" targetId="cp-faction::emperor-s-children" primary="false" />
        <categoryLink id="897fe76d" name="Chaos" hidden="false" targetId="cp-group::chaos" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="182fed5d" name="Duellist’s Death" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Fight phase, just after an enemy unit has selected its targets.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One EMPEROR’S CHILDREN unit from your army that was selected as the target of one or more of the attacking unit’s attacks.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, each time a model in your unit is destroyed, if that model has not fought this phase, roll one D6, adding 1 to the result if your unit has the FLAWLESS BLADES keyword. On a 4+, do not remove the destroyed model from play; it can fight after the attacking unit has finished making its attacks, and is then removed from play.</characteristic>
          </characteristics>
        </profile>
        <profile id="07975f19" name="Shatter Strike" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Fight phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One FLAWLESS BLADES unit from your army that has not been selected to fight this phase.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, add 1 to the Damage characteristic of melee weapons equipped by models in your unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="e9ca22e2" name="Obsessive Focus" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Command phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One EMPEROR’S CHILDREN unit from your army.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the start of your next Command phase, you can ignore any or all modifiers to the characteristics of models in your unit (excluding the Objective Control characteristic) and any weapons they are equipped with, and you can ignore any or all modifiers to the characteristics of attacks made by models in your unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="910bae05" name="Trophy for the Dark Prince" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">When your opponent’s WARLORD is destroyed, you score the number of VP shown in the table below, based on which battle round it is destroyed in.</characteristic>
          </characteristics>
        </profile>
        <profile id="75db7224" name="Fleeting Possession" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">From the second battle round onwards, at the end of your turn, you score 2VP if you control one or more objective markers that you did not control at the start of that turn.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
