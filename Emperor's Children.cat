        <profile id="23302957" name="Euphoric Strikes" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Once per battle, at the start of the Fight phase, this model can use this ability. If it does, until the end of the phase, add 3 to the Attacks characteristic of melee weapons equipped by this model and improve the Armour Penetration characteristic of those weapons by 1.</characteristic>
          </characteristics>
        </profile>
        <profile id="fe1d074e" name="Leader" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">This model can be attached to the following unit: Infractors.</characteristic>
          </characteristics>
        </profile>
        <profile id="340061a5" name="Enhancement: Distorting Vapours (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">While the bearer is leading a unit, models in that unit have the Stealth ability and that unit can only be selected as the target of a ranged attack if the attacking model is within 18". (Default enhancement; may be replaced with Transhuman Speed.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
