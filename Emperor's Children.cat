<catalogue id="cp-catalogue::emperors-children" name="Emperor's Children" gameSystemId="cp01-4a7e-9d3b-0001" gameSystemRevision="1" battleScribeVersion="2.03" revision="1" authorName="Armamentarium" library="false" xmlns="http://www.battlescribe.net/schema/catalogueSchema">
  <selectionEntries>
    <selectionEntry id="cp::callous-blades::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="83b890a2" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="40d60930" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="bb41536e" name="Combat Patrol: Emperor's Children (Callous Blades)" hidden="false" targetId="cp-cat::callous-blades" primary="true" />
        <categoryLink id="4ea6be5e" name="Emperor's Children" hidden="false" targetId="cp-faction::emperor-s-children" primary="false" />
        <categoryLink id="8c28a139" name="Chaos" hidden="false" targetId="cp-group::chaos" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="a7acef13" name="Pact of Excess" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">When mustering your army, unless specifically stated otherwise, you cannot select LEGIONS OF EXCESS as your Army Faction.</characteristic>
          </characteristics>
        </profile>
        <profile id="6972ac59" name="Thrill Seekers" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">If your Army Faction is EMPEROR’S CHILDREN, this unit is eligible to shoot and declare a charge in a turn in which it Advanced or Fell Back, but when doing so: ■ It cannot target a unit it was within Engagement Range of at the start of the turn. ■ It cannot target a unit that was the target of another unit’s charge or attack this phase.</characteristic>
          </characteristics>
        </profile>
        <profile id="e486dc21" name="Nimble Strikes" typeId="3f92bd18" typeName="Detachment" hidden="false">
          <characteristics>
            <characteristic name="DP" typeId="5b7c1e90">1DP</characteristic>
            <characteristic name="Rule" typeId="e8340af2">When friendly CALLOUS BLADES units start a normal/advance/charge move, those units can move through models (excluding MONSTER/VEHICLE models).</characteristic>
            <characteristic name="Force Disposition" typeId="9c61d5b4">Purge the Foe</characteristic>
          </characteristics>
        </profile>
        <profile id="358d7073" name="Invigorating Agonies" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">CALLOUS BLADES LORD EXULTANT model only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">(Once per battle, per army) In your opponent's Shooting phase, when an enemy unit has shot, if this unit was hit by those attacks, you can use this ability. If you do, this unit can make a surge move of up to D3+1&quot;.</characteristic>
          </characteristics>
        </profile>
        <profile id="cbe097fc" name="Martial Perfection" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">CALLOUS BLADES INFRACTORS unit only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">(Once per battle, per army) In the Fight phase, when an enemy unit targets this unit, you can use this ability. If you do, attacks that target your unit have -1 to hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile id="5391b885" name="Duellist’s Death" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Fight phase, when an enemy unit targets a friendly CALLOUS BLADES unit.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That CALLOUS BLADES unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">When a model in your unit is destroyed, if your unit has not been selected to fight this phase, roll one D6, with +1 to the result if your unit has FLAWLESS BLADES:On a 4+, do not remove that model from the battlefield. When your unit has fought, or at the end of the phase (whichever comes first), that model is removed from the battlefield.</characteristic>
          </characteristics>
        </profile>
        <profile id="3f9c0fd2" name="Shatter Strike" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Fight phase, when a friendly CALLOUS BLADES FLAWLESS BLADES unit is selected to fight.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That CALLOUS BLADES FLAWLESS BLADES unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit's melee attacks have +1 D.</characteristic>
          </characteristics>
        </profile>
        <profile id="bd5ee869" name="Profane Desecration" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">End of your Movement phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One friendly CALLOUS BLADES unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Select one objective your unit is controlling. That objective is secured.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
