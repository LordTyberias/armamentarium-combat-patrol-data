  <selectionEntries>
    <selectionEntry id="cp::guardians-of-the-throne::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="fe9301f7" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="cbe7dc6c" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="8f49a8b1" name="Combat Patrol: Adeptus Custodes (Guardians of the Throne)" hidden="false" targetId="cp-cat::guardians-of-the-throne" primary="true" />
        <categoryLink id="db635670" name="Adeptus Custodes" hidden="false" targetId="cp-faction::adeptus-custodes" primary="false" />
        <categoryLink id="4fadaaf7" name="Imperium" hidden="false" targetId="cp-group::imperium" primary="false" />
        <categoryLink id="bdef466a" name="Legacy" hidden="false" targetId="cp-flag::legacy" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="6b160c41" name="Wrath of the Host" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Any phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One SHIELD-CAPTAIN model from your army that was just destroyed by an attack made by an enemy model. You can use this Stratagem on that model even though it was just destroyed.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the battle, ranged weapons equipped by ADEPTUS CUSTODES models from your army have the [SUSTAINED HITS 1] ability while targeting that enemy model’s unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="7d00d2a6" name="Gilded Magnificence" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">2CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Command phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ADEPTUS CUSTODES unit from your army.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the start of your next Command phase, add 1 to the Objective Control characteristic of models in your unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="d1272138" name="Tireless Pursuit" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Movement phase, just after an enemy unit ends a Fall Back move.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ADEPTUS CUSTODES INFANTRY unit from your army that was within Engagement Range of that enemy unit at the start of the phase.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">If your unit is not within Engagement Range of one or more enemy models, it can make a Normal move.</characteristic>
          </characteristics>
        </profile>
        <profile id="cfc3d27c" name="Guardian of the Realm" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the end of each phase, you score 1VP if your SHIELD-CAPTAIN model destroyed one or more enemy models that phase. If any of those enemy models’ units started that phase within range of an objective marker, you score 2VP instead.</characteristic>
          </characteristics>
        </profile>
        <profile id="80639b28" name="Drive the Talons Deep" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">From the second battle round onwards, at the end of your opponent’s turn, you score 3VP if one or more ADEPTUS CUSTODES units from your army (excluding Battle-shocked units) are wholly within your opponent’s deployment zone.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
