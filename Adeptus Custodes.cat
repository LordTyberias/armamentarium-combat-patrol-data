      <constraints>
        <constraint id="389910b3" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="f0790ef5" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="f35fc9ef" name="Combat Patrol: Adeptus Custodes (Tristraen's Gilded Blades)" hidden="false" targetId="cp-cat::tristraens-gilded-blades" primary="true" />
        <categoryLink id="66bcdb68" name="Adeptus Custodes" hidden="false" targetId="cp-faction::adeptus-custodes" primary="false" />
        <categoryLink id="846a603a" name="Imperium" hidden="false" targetId="cp-group::imperium" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="134020c3" name="The Gilded Spear" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Fight phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ADEPTUS CUSTODES unit from your army that has not been selected to fight this phase.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, each time a model in your unit makes a Pile‑in move, it can move up to 6" instead of up to 3".</characteristic>
          </characteristics>
        </profile>
        <profile id="bf917f25" name="Inescapable Vengeance" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Movement phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ADEPTUS CUSTODES unit from your army that has not been selected to move this phase.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, add 2 to Advance rolls made for your unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="6afc5ae4" name="Overawing Magnificence" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Charge phase, just after an enemy unit declares a charge.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ADEPTUS CUSTODES unit that was selected as a target of that charge.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">That enemy unit must take a Leadership test. If that test is failed, until the end of the phase, subtract 2 from Charge rolls made for that enemy unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="8dd32a2f" name="Raise the Vexillas" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">From the third battle round onwards, at the end of your turn, you score 3VP if you control the objective marker closest to your opponent’s battlefield edge and you also control the objective marker closest to your battlefield edge.</characteristic>
          </characteristics>
        </profile>
        <profile id="a8288e84" name="Victory’s Price" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">■ Each time an enemy unit is destroyed, you score 3VP. ■ Each time an ADEPTUS CUSTODES model from your army is destroyed, you lose 1VP (to a minimum of 0VP).</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
