        <profile id="ddb48282" name="Enhancement: Aegis Vigilate (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Add 1 to the Toughness characteristic of models in the bearer's unit, and those models have a 4+ invulnerable save. (Default enhancement; may be replaced with Aliens' Bane: The bearer's melee weapons have the [Precision] ability and each time the bearer makes a melee attack, add 1 to the Wound roll.)</characteristic>
