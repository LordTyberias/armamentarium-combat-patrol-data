        <profile id="287a4267" name="Enhancement: Skulls for Khorne (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Each time the bearer destroys an enemy unit with a melee attack, roll one D6: on a 2+, you gain 1CP. (Default enhancement; may be replaced with Arch-slaughterer: Melee weapons equipped by the bearer have the [PRECISION] ability.)</characteristic>
          </characteristics>
