      <selectionEntries>
        <selectionEntry id="cp::siguards-crusaders::01-primaris-crusader-squad::primaris-sword-brother-heavy-bolt-pistol-power-weapon" name="Primaris Sword Brother: heavy bolt pistol, power weapon" type="upgrade" hidden="false">
