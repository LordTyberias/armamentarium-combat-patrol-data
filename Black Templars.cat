        <rule id="a30659ca" name="Righteous Zeal" hidden="false">
          <description>You can re-roll Advance and Charge rolls made for this unit.</description>
        </rule>
        <rule id="da581be6" name="Patrol Squads" hidden="false">
          <description>At the start of the Declare Battle Formations step, before any units have been set up, this unit can be split into two units, each containing five models. If you do so, one of those units must contain the Primaris Initiate models and the other unit must contain the remaining models.</description>
        </rule>
