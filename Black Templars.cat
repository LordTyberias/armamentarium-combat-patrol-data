        <selectionEntry id="cp::siguards-crusaders::01-primaris-crusader-squad::2-primaris-initiates-heavy-bolt-pistol-astartes-chainsword" name="2 Primaris Initiates: heavy bolt pistol, Astartes chainsword" type="upgrade" hidden="false">
