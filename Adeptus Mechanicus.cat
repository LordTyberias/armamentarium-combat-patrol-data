        <profile id="84d0febd" name="Line-breakers" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Each time this unit ends a Charge move, select one enemy unit within Engagement Range of it and roll one D6 for each model in this unit that is within Engagement Range of that enemy unit, adding 2 to the result if this unit started its Charge move within 6" of one or more friendly Adeptus Mechanicus Battleline units. For each 4+, that enemy unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
      </profiles>
