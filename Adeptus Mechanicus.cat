        <profile id="fe1d074e" name="Leader" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">This model can be attached to the following unit: Skitarii Rangers.</characteristic>
          </characteristics>
        </profile>
        <profile id="9fd70fe1" name="Enginseer" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">While this model is within 3" of one or more friendly Adeptus Mechanicus Vehicle units, unless it is leading a unit, this model has the Lone Operative ability.</characteristic>
          </characteristics>
        </profile>
        <profile id="ddae276d" name="Omnissiah's Blessing" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">In your Command phase, select one friendly Adeptus Mechanicus model within 3" of this model. That model regains up to D3 lost wounds. Each model can only be selected for this ability once per Command phase.</characteristic>
          </characteristics>
        </profile>
        <profile id="fd193313" name="Enhancement: Omniballistic Data-Tether (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Each time the bearer's unit is selected to shoot, you can re-roll one Hit roll and you can re-roll one Wound roll when resolving those attacks. (Default enhancement; may be replaced with Imperative Surge-wafer: Once per battle, when the bearer's unit is selected to shoot, it can use this ability. If it does, until the end of the phase, ranged weapons equipped by models in the bearer's unit have the [PRECISION] ability.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
