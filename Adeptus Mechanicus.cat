    <selectionEntry id="cp::purge-corps-deltic-9::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="79e41ce0" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="5f40f208" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="c44d5785" name="Combat Patrol: Adeptus Mechanicus (Purge Corps Deltic-9)" hidden="false" targetId="cp-cat::purge-corps-deltic-9" primary="true" />
        <categoryLink id="8d634105" name="Adeptus Mechanicus" hidden="false" targetId="cp-faction::adeptus-mechanicus" primary="false" />
        <categoryLink id="da7eb8a6" name="Imperium" hidden="false" targetId="cp-group::imperium" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="5a6c16f1" name="Doctrina Imperatives" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">At the start of the battle round, you can select one of the Doctrina Imperatives below. Until the end of the battle round, that Doctrina Imperative is active for your army, and all units from your army that have the Doctrina Imperatives ability gain the relevant abilities shown below. ■ Ranged weapons equipped by models in this unit have the [HEAVY] ability. ■ Improve the Ballistic Skill characteristic of ranged weapons equipped by models in this unit by 1. ■ Each time a melee attack targets this unit, if this unit has the BATTLELINE keyword and/or it is within 6&quot; of one or more friendly ADEPTUS MECHANICUS BATTLELINE units, subtract 1 from the Hit roll. ■ Ranged weapons equipped by models in this unit have the [ASSAULT] ability. ■ Improve the Weapon Skill characteristic of melee weapons equipped by models in this unit by 1. ■ Each time a model in this unit makes an attack, if this unit has the BATTLELINE keyword and/or it is within 6&quot; of one or more friendly ADEPTUS MECHANICUS BATTLELINE units, improve the Armour Penetration characteristic of that attack by 1.</characteristic>
          </characteristics>
        </profile>
        <profile id="c2c01f67" name="Imperative Overload" typeId="3f92bd18" typeName="Detachment" hidden="false">
          <characteristics>
            <characteristic name="DP" typeId="5b7c1e90">1DP</characteristic>
            <characteristic name="Rule" typeId="e8340af2">At the start of the battle round, you can select one friendly PURGE CORPS DELTIC-9 unit. If you do, that unit has both Doctrina Imperative abilities until the end of the battle round.</characteristic>
            <characteristic name="Force Disposition" typeId="9c61d5b4">Purge the Foe</characteristic>
          </characteristics>
        </profile>
        <profile id="02817881" name="Miniaturised Autosimulacra" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">PURGE CORPS DELTIC-9 TECH-PRIEST MANIPULUS model only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">(Once per battle, per unit) At the start of any phase, you can use this ability. If you do, select one friendly PURGE CORPS DELTIC-9 unit. That unit heals D3+2 wounds.</characteristic>
          </characteristics>
        </profile>
        <profile id="ce085a0a" name="Empowered Mechanisms" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">PURGE CORPS SERBERYS SULPHURHOUNDS unit only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">This unit's ranged attacks have [ANTI-INFANTRY 4+].This unit can re-roll rolls to determine the A of a weapon.</characteristic>
          </characteristics>
        </profile>
        <profile id="2b5d4014" name="Lockdown Protocols" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent's Shooting phase or the Fight phase, when an enemy unit targets a friendly PURGE CORPS DELTIC-9 unit that is within range of an objective.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That PURGE CORPS DELTIC-9 unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Attacks that target your unit have -1 to wound rolls.</characteristic>
          </characteristics>
        </profile>
        <profile id="680d9e8d" name="Preservation Imperatives" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase, when a friendly unengaged PURGE CORPS DELTIC-9 unit has shot.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That PURGE CORPS DELTIC-9 unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit can make a normal move of up to D3+1&quot;.Your unit is not eligible to declare a charge until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="24e702e2" name="Optimised Targeting" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase, when a friendly PURGE CORPS DELTIC-9 unit is selected to shoot.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That PURGE CORPS DELTIC-9 unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit's ranged attacks can re-roll hit rolls of 1.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
