  <selectionEntries>
    <selectionEntry id="cp::kygharils-protectors::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="d2fe83ad" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="0743bf4a" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="0eca11fa" name="Combat Patrol: Aeldari (Kygharil's Protectors)" hidden="false" targetId="cp-cat::kygharils-protectors" primary="true" />
        <categoryLink id="1d260d99" name="Aeldari" hidden="false" targetId="cp-faction::aeldari" primary="false" />
        <categoryLink id="7bbb8b95" name="Xenos" hidden="false" targetId="cp-group::xenos" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="f1ed2c3f" name="Focused Firepower" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Start of your Shooting phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One or more ASURYANI units from your army.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Select one enemy unit. Until the end of the phase, each time a model in one of your units makes an attack that targets that enemy unit, re‑roll a Wound roll of 1.</characteristic>
          </characteristics>
        </profile>
        <profile id="07028cbe" name="Swift Deception" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Start of your opponent’s Charge phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ASURYANI unit from your army (excluding WRAITHBLADES units).</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit can make a Normal move of up to D3".</characteristic>
          </characteristics>
        </profile>
        <profile id="9d56cfe7" name="Elusive" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Shooting phase, just after an enemy unit has selected its targets.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ASURYANI unit from your army (excluding WRAITHBLADES units) that was selected as the target of one or more of the attacking unit’s attacks.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, models in your unit have the Stealth ability and each time a ranged attack targets your unit, models in it have the Benefit of Cover against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile id="32b07e9a" name="Protect the Future" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the start of the Declare Battle Formations step, select one enemy unit (excluding CHARACTER units). The selected unit must be an INFANTRY or MOUNTED unit, if possible. When that enemy unit is destroyed, you score 9VP. If your SPIRITSEER model is on the battlefield when that enemy unit is destroyed, you score 12VP instead.</characteristic>
          </characteristics>
        </profile>
        <profile id="3ab962b1" name="Recover the Spirit Stones" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the start of your turn, select one objective marker within No Man’s Land. At the end of your opponent’s next turn or the end of the battle (whichever comes first), if you control that objective marker, you score 3VP.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
