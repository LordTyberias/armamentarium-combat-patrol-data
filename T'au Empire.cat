    <selectionEntry id="cp::sudden-dawn-cadre::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="e0100d43" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="acbf7bd4" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="4a6d58be" name="Combat Patrol: T'au Empire (Sudden Dawn Cadre)" hidden="false" targetId="cp-cat::sudden-dawn-cadre" primary="true" />
        <categoryLink id="d792dd18" name="T'au Empire" hidden="false" targetId="cp-faction::t-au-empire" primary="false" />
        <categoryLink id="e3e89945" name="Xenos" hidden="false" targetId="cp-group::xenos" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="216b0620" name="Fight by the Code" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One T’AU EMPIRE unit from your army.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, your unit is eligible to shoot in a turn in which it Fell Back.</characteristic>
          </characteristics>
        </profile>
        <profile id="92becb92" name="Rampart of Fire" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One T’AU EMPIRE unit from your army that has not been selected to shoot this phase.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, each time a model in your unit makes an attack that targets an enemy unit within 10", improve the Armour Penetration characteristic of that attack by 1.</characteristic>
          </characteristics>
        </profile>
        <profile id="a3bfa1ba" name="Lives Before Territory" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Shooting phase, just after an enemy unit has selected its targets.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One T’AU EMPIRE INFANTRY or T’AU EMPIRE BATTLESUIT unit from your army that was selected as the target of one or more of the attacking unit’s attacks.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit can make a Normal move of up to D6" and, until the end of the phase, each time an attack targets your unit, it has the Benefit of Cover against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile id="3a012e6a" name="Surprise Attack" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">In the first and second battle rounds: At the end of you turn, you score 4VP for each objective marker in No Man’s Land you control. In the third, fourth and fifth battle rounds: At the end of you turn, you score 2VP for each objective marker in No Man’s Land you control.</characteristic>
          </characteristics>
        </profile>
        <profile id="24b6a970" name="Ethereal Edict" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the start of the first battle round, your opponent must select one unit from their army. At the end of the battle, you score 12VP if that unit is destroyed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
