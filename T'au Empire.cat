        </rule>
        <rule id="e48838e8" name="Grav-inhibitor Drone" hidden="false">
          <description>Each time an enemy unit selects the bearer's unit as the target of a charge, subtract 2 from the Charge roll (this is not cumulative with any other negative modifiers to that Charge roll).</description>
        </rule>
