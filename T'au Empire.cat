        <profile id="08197c47" name="Marker Drone" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">The bearer's unit has the Markerlight keyword and can act as an Observer unit for another unit even if it Advanced this turn.</characteristic>
