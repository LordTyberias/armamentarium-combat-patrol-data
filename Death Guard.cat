  <selectionEntries>
    <selectionEntry id="cp::maggot-lords::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="058e4be4" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="0814126f" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="2fe0c987" name="Combat Patrol: Death Guard (Maggot Lords)" hidden="false" targetId="cp-cat::maggot-lords" primary="true" />
        <categoryLink id="52b9449c" name="Death Guard" hidden="false" targetId="cp-faction::death-guard" primary="false" />
        <categoryLink id="2b63537b" name="Chaos" hidden="false" targetId="cp-group::chaos" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="cae60535" name="Nurgle’s Gift (Aura)" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">If your Army Faction is DEATH GUARD, while an enemy unit is within Contagion Range of one or more DEATH GUARD models from your army, it is Afflicted (see below). Contagion Range changes over the course of the battle, as shown below. Contagion Range cannot be greater than 12&quot; after modifiers. During the Declare Battle Formations step, select one of the Plagues below. Until the end of the battle, while an enemy unit is Afflicted, subtract 1 from the Toughness characteristic of models in that unit, and that unit has the effect of your chosen Plague.</characteristic>
          </characteristics>
        </profile>
        <profile id="dc82795e" name="Pact of Decay" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">When mustering your army, unless specifically stated otherwise, you cannot select PLAGUE LEGIONS as your Army Faction.</characteristic>
          </characteristics>
        </profile>
        <profile id="b3886078" name="Creeping Rot" typeId="3f92bd18" typeName="Detachment" hidden="false">
          <characteristics>
            <characteristic name="DP" typeId="5b7c1e90">1DP</characteristic>
            <characteristic name="Rule" typeId="e8340af2">Friendly MAGGOT LORDS TERMINATOR units have Scouts 3&quot;.</characteristic>
            <characteristic name="Force Disposition" typeId="9c61d5b4">Purge the Foe</characteristic>
          </characteristics>
        </profile>
        <profile id="4ea67cdd" name="Noisome Veil" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">MAGGOT LORDS TALLYMAN model only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">(Once per battle, per army) In your opponent's Shooting phase, when an enemy unit targets this unit, you can use this ability. If you do, this unit has Stealth.</characteristic>
          </characteristics>
        </profile>
        <profile id="b1643a71" name="Bountiful Regeneration" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">MAGGOT LORDS LORD OF VIRULENCE model only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">In your Command phase, this model heals 1 wound.</characteristic>
          </characteristics>
        </profile>
        <profile id="f90fe948" name="Inexorable Executioners" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Charge phase, when a friendly MAGGOT LORDS DEATHSHROUD TERMINATORS unit starts a charge move.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That MAGGOT LORDS DEATHSHROUD TERMINATORS unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit can move through models (excluding MONSTER/VEHICLE models).</characteristic>
          </characteristics>
        </profile>
        <profile id="eb22770f" name="Vomitous Salvoes" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase, when a friendly MAGGOT LORDS PLAGUE MARINES unit is selected to shoot.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That MAGGOT LORDS PLAGUE MARINES unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit's Lethal Hits ranged attacks have [RAPID FIRE 1].</characteristic>
          </characteristics>
        </profile>
        <profile id="270905c0" name="Sickening Horror" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Start of the Fight phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One friendly MAGGOT LORDS INFANTRY unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Select one enemy unit engaged with your unit. That enemy unit makes a battle-shock roll.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
