        <profile id="de8efaca" name="Blight Bombardment" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">At the start of your Shooting phase, select one enemy unit within 30" of and visible to this model. Until the end of the phase, each time a friendly Death Guard model makes a ranged attack that targets that unit, re-roll a Hit roll of 1 (if that attack is made with a Blast weapon, you can re-roll the Hit roll instead).</characteristic>
          </characteristics>
        </profile>
        <profile id="2b49699d" name="Enhancement: Bountiful Regeneration (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">At the start of your Command phase, the bearer regains up to 1 lost wound. (Default enhancement; may be replaced with Vision of Vileness.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="8b20963f" name="Blight Bombardment" hidden="false">
