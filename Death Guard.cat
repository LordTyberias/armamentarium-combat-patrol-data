        <profile id="a6fe5af6" name="Entropic Afflictions (Aura)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48"></characteristic>
          </characteristics>
        </profile>
        <profile id="27caeb52" name="Inflamed Infections" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">At the start of the Fight phase, select one enemy unit within Engagement Range of this model. Until the end of the phase, each time this model makes an attack that targets that unit, an unmodified Hit roll of 5+ scores a Critical Hit. If that unit is Below Half-strength, an unmodified Hit roll of 4+ scores a Critical Hit instead.</characteristic>
          </characteristics>
        </profile>
        <profile id="fe1d074e" name="Leader" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">This model can be attached to the following unit: Plague Marines.</characteristic>
          </characteristics>
        </profile>
        <profile id="57925ed9" name="Enhancement: Gnawslop (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Improve the Strength, Armour Penetration and Damage characteristics of melee weapons equipped by the bearer by 1. (Default enhancement; may be replaced with Festerflute, which lets you add the Nurglings unit from Reserves once per battle.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="5c554a0a" name="Inflamed Infections" hidden="false">
          <description>At the start of the Fight phase, select one enemy unit within Engagement Range of this model. Until the end of the phase, each time this model makes an attack that targets that unit, an unmodified Hit roll of 5+ scores a Critical Hit. If that unit is Below Half-strength, an unmodified Hit roll of 4+ scores a Critical Hit instead.</description>
        </rule>
        <rule id="4541f07f" name="Leader" hidden="false">
          <description>This model can be attached to the following unit: Plague Marines.</description>
        </rule>
        <rule id="b3e60eda" name="Enhancement: Gnawslop (Warlord)" hidden="false">
          <description>Improve the Strength, Armour Penetration and Damage characteristics of melee weapons equipped by the bearer by 1. (Default enhancement; may be replaced with Festerflute, which lets you add the Nurglings unit from Reserves once per battle.)</description>
        </rule>
      </rules>
