          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Improve the Strength, Armour Penetration and Damage characteristics of melee weapons equipped by the bearer by 1. (Default enhancement; may be replaced with Festerflute, which lets you add the Nurglings unit from Reserves once per battle.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
