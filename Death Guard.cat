        </rule>
        <rule id="a23d028b" name="Enhancement: Bountiful Regeneration (Warlord)" hidden="false">
          <description>At the start of your Command phase, the bearer regains up to 1 lost wound. (Default enhancement; may be replaced with Vision of Vileness.)</description>
