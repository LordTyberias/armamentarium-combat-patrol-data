        <profile id="c80b5a57" name="Harbinger of Despair" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Once per turn, at the start of your Command, Movement, Shooting, Charge or Fight phase, you can select one enemy unit within 18" of this model. That unit must take a Battle-shock test, subtracting 1 from the test when it does so.</characteristic>
          </characteristics>
        </profile>
        <profile id="fe1d074e" name="Leader" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">This model can be attached to the following unit: Immortals</characteristic>
          </characteristics>
        </profile>
        <profile id="6cd39512" name="Enhancement: Neuroflense Protocols (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">The bearer's weapons have: the [Precision] ability; an Attacks characteristic of 3 while targeting a Battle-shocked unit, and each time the bearer makes an attack that targets such a unit, add 1 to the Hit roll. (Default enhancement; may be replaced with Shambling Resurrection: Once per turn, in your opponent's Shooting phase, just after an enemy unit has shot, if one or more models from the bearer's unit were destroyed as a result of those attacks, the bearer can use this Enhancement. If it does, the bearer's unit's Reanimation Protocols activate.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="05a89cb8" name="Harbinger of Despair" hidden="false">
          <description>Once per turn, at the start of your Command, Movement, Shooting, Charge or Fight phase, you can select one enemy unit within 18" of this model. That unit must take a Battle-shock test, subtracting 1 from the test when it does so.</description>
        </rule>
        <rule id="4541f07f" name="Leader" hidden="false">
