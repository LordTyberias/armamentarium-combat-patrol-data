          <characteristics>
            <characteristic name="Description" typeId="2451ab48"></characteristic>
          </characteristics>
        </profile>
        <profile id="fcdb8232" name="Synapse" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48"></characteristic>
          </characteristics>
        </profile>
        <profile id="9b4339ac" name="Death Blow" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">In the fight phase, when this model is destroyed, if this unit has not been selected to fight this phase, roll one D6:On a 4+, do not remove this model from the battlefield. When your unit has fought, or at the end of the phase (whichever comes first), this model is removed from the battlefield.</characteristic>
          </characteristics>
        </profile>
        <profile id="ca071c9c" name="Bio-Reserves (once per battle per unit)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">At the start or end of your Movement phase, you can use this ability. If you do:Select one friendly unengaged VARDENGHAST SWARM TERMAGANTS unit. That unit heals 2D6 wounds.Or: Select one friendly destroyed VARDENGHAST SWARM TERMAGANTS unit. That unit heals 10 wounds and is placed in strategic reserves.</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <selectionEntries>
