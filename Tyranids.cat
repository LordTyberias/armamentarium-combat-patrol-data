          <characteristics>
            <characteristic name="Range" typeId="0c6c6741">Melee</characteristic>
            <characteristic name="A" typeId="b10eaf4e">6</characteristic>
            <characteristic name="WS" typeId="258d9251">2+</characteristic>
            <characteristic name="S" typeId="09c93781">6</characteristic>
