        </profile>
        <profile id="b7881006" name="Vengeance of the Omnissiah" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">If a friendly Adeptus Astartes Vehicle model is destroyed within 12" of this model, until the end of the battle, this model's Omnissian power axe has an Attacks characteristic of 7.</characteristic>
          </characteristics>
        </profile>
        <profile id="81d35e3e" name="Enhancement: Gorgon's Rage (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Melee weapons equipped by the bearer have a Weapon Skill characteristic of 2+ and the [Sustained Hits 1] ability. (Default enhancement; may be replaced with Machine Unity: In the Declare Battle Formations step, the bearer can be attached to a Heavy Intercessor Squad.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
