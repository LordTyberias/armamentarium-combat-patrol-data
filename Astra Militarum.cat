        <profile id="8551aafa" name="Voice of Command" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48"></characteristic>
          </characteristics>
        </profile>
        <profile id="9d8ce8e7" name="Warrior Elite (once per battle round, per unit)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">At the start of any phase, you can use this ability. If you do, select one Order. That Order affects this unit, in addition to any other Orders issued to this unit, until the start of your next Command phase.</characteristic>
          </characteristics>
        </profile>
        <profile id="56005249" name="Melta Mine (once per battle, per unit)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">At the start of any phase, you can use this ability. If you do, select one enemy unit within 3&quot; of this model and roll one D6. On a 2+:That enemy unit suffers D3 mortal wounds.Or: If that enemy unit has VEHICLE, that enemy unit suffers 2D3 mortal wounds.</characteristic>
          </characteristics>
        </profile>
        <profile id="0991c3d0" name="Vox‑caster" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
