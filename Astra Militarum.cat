    <selectionEntry id="cp::karsks-gunners::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="358d3e09" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="71a4aaf2" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="18768cfc" name="Combat Patrol: Astra Militarum (Karsk's Gunners)" hidden="false" targetId="cp-cat::karsks-gunners" primary="true" />
        <categoryLink id="a06dff34" name="Astra Militarum" hidden="false" targetId="cp-faction::astra-militarum" primary="false" />
        <categoryLink id="27f14c06" name="Imperium" hidden="false" targetId="cp-group::imperium" primary="false" />
        <categoryLink id="99f895a7" name="Legacy" hidden="false" targetId="cp-flag::legacy" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="94995ce6" name="Send in the Next Wave" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Reinforcements step of your Movement phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One destroyed CADIAN SHOCK TROOPS unit from your army. You can use this Stratagem on that unit even though it is destroyed.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Add a new unit to your army identical to your destroyed unit, at its original Starting Strength. Set that unit up anywhere on the battlefield wholly within 9" of your battlefield edge and not within Engagement Range of one or more enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile id="a5be6d82" name="Bring It Down" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">Any number of ASTRA MILITARUM units from your army, and one enemy unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, each time a model in one of your selected units makes an attack that targets that enemy unit, you can re-roll the Hit roll.</characteristic>
          </characteristics>
        </profile>
        <profile id="a1ad184b" name="Artillery Strike" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">2CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Start of your opponent’s Command phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One OFFICER model from your army.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the turn, halve the Move characteristic of enemy models, halve Advance rolls made for enemy units, enemy units cannot declare a charge and each time an enemy model makes a ranged attack, subtract 1 from the Hit roll. RESTRICTIONS: You can only use this Stratagem once per battle.</characteristic>
          </characteristics>
        </profile>
        <profile id="cd7c843a" name="Hold the Line" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the end of your opponent’s turn, you score 3VP if there are no enemy units wholly within your deployment zone (excluding Battle-shocked units). If there are no enemy units wholly within 6" of your deployment zone (excluding Battle-shocked units), you score 5VP instead.</characteristic>
          </characteristics>
        </profile>
        <profile id="7e9d6aaf" name="Methodical Destruction" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the start of the battle round, select one enemy unit that is not destroyed to be your army’s target for that battle round. At the end of that battle round, you score 4VP if your army’s target for that battle round is destroyed.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
