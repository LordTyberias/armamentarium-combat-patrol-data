    <selectionEntry id="cp::death-korps-combat-platoon::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="2e3baac9" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="118f7232" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="55a74464" name="Combat Patrol: Astra Militarum (Death Korps Combat Platoon)" hidden="false" targetId="cp-cat::death-korps-combat-platoon" primary="true" />
        <categoryLink id="2ab05e8f" name="Astra Militarum" hidden="false" targetId="cp-faction::astra-militarum" primary="false" />
        <categoryLink id="721cac67" name="Imperium" hidden="false" targetId="cp-group::imperium" primary="false" />
        <categoryLink id="cd396f42" name="Legacy" hidden="false" targetId="cp-flag::legacy" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="2e9a8ebc" name="Fresh Waves" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Reinforcements step of your Movement phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One destroyed DEATH KORPS OF KRIEG or DEATH RIDERS unit from your army. You can use this Stratagem on that unit even though it is destroyed.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Add a new unit to your army identical to your destroyed unit, at its original Starting Strength. Set that unit up anywhere on the battlefield wholly within 9" of one or more battlefield edges and not within Engagement Range of one or more enemy units.</characteristic>
          </characteristics>
        </profile>
        <profile id="48d73f54" name="Fiendslayer Munitions" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">Any number of ASTRA MILITARUM units from your army, and one enemy VEHICLE or MONSTER unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, each time a model in one of your selected units makes an attack that targets that enemy unit: • Improve the Armour Penetration characteristics of Ranged weapons equipped by models in the selected units by 1. • Ranged weapons equipped by models in the selected units have the [ANTI‑VEHICLE 4+] and [ANTI‑MONSTER 4+] abilities.</characteristic>
          </characteristics>
        </profile>
        <profile id="a1c3eff2" name="Smoke Barrage" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Start of your opponent’s Charge phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One ASTRA MILITARUM unit from your army.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, each time an enemy unit selects your unit as the target of a charge, subtract 2 from the Charge roll (this is not cumulative with any other negative modifiers to that Charge roll).</characteristic>
          </characteristics>
        </profile>
        <profile id="f4ed06d9" name="All Fronts Advance" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the end of each player’s turn, you score 5VP if you control one or more objective markers not within your deployment zone.</characteristic>
          </characteristics>
        </profile>
        <profile id="79fee1ef" name="Hold and Repel" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the end of your opponent’s turn, you score 3VP if there are no enemy units wholly within your deployment zone (excluding Battle-shocked units). If there are no enemy units wholly within 6" of your deployment zone (excluding Battle-shocked units), you score 5VP instead.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
