        </profile>
        <profile id="eec9cde6" name="Master Vox" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Each time the Officer in the bearer's unit issues an Order, it can issue it to an eligible unit up to 24" away.</characteristic>
          </characteristics>
        </profile>
        <profile id="f5e8b66b" name="Servo-scribes" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Once per battle, when issuing an Order, the Lord Commissar can issue one additional Order.</characteristic>
