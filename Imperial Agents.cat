    <selectionEntry id="cp::vantarrions-voidsmen::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="845efd3f" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="a19c50c7" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="28b54d93" name="Combat Patrol: Imperial Agents (Vantarrion's Voidsmen)" hidden="false" targetId="cp-cat::vantarrions-voidsmen" primary="true" />
        <categoryLink id="7a74b67d" name="Imperial Agents" hidden="false" targetId="cp-faction::imperial-agents" primary="false" />
        <categoryLink id="de231f0d" name="Imperium" hidden="false" targetId="cp-group::imperium" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="2e3899ba" name="Small-arms Broadside" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One NAVIS IMPERIALIS unit from your army that has not been selected to shoot this phase.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, improve the Attacks and Ballistic Skill characteristics of ranged weapons equipped by models in your unit by 1.</characteristic>
          </characteristics>
        </profile>
        <profile id="cf7c8b52" name="Bulkhead By Bulkhead" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Movement phase, just after an enemy unit ends a Normal, Advance or Fall Back move.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One NAVIS IMPERIALIS unit from your army that is within 9" of that enemy unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit can make a Normal move of up to D6".</characteristic>
          </characteristics>
        </profile>
        <profile id="62301c58" name="Shipmaster’s Vengeance" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Shooting phase, just after an enemy unit has selected its targets.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One NAVIS IMPERIALIS unit from your army that is not within Engagement Range of any enemy units and was selected as the target of one or more of the attacking unit’s attacks.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, each time a model in your unit is destroyed, roll one D6: on a 4+, do not remove the destroyed model from play; it can shoot after the attacking unit has finished making its attacks and is then removed from play.</characteristic>
          </characteristics>
        </profile>
        <profile id="01446229" name="Glittering Prizes" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the end of your turn, if your WARLORD is within range of an objective marker, roll one D6: on a 1, you score 1VP; on a 2-4, you score D3+1VP; on a 5+, you score 4VP.</characteristic>
          </characteristics>
        </profile>
        <profile id="0a9d0108" name="Landing Party" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the end of your opponent’s turn, if you have one or more units from your army wholly within your opponent’s deployment zone and one or more units from your army wholly within No Man’s Land, you score 5VP. Otherwise, if you have one or more units from your army wholly within your deployment zone and one or more units from your army wholly within No Man’s Land, you score 2VP.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
