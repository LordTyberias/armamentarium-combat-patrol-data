        <profile id="a2f10cc3" name="Enhancement: Deadly Duellist (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Melee weapons equipped by the bearer have the [Lethal Hits] ability. (Default enhancement; may be replaced with Area Denial: At the end of your Command phase, if the bearer's unit is within range of an objective marker you control, that objective marker remains under your control, even if you have no models within range of it, until your opponent controls it at the start or end of any turn.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
