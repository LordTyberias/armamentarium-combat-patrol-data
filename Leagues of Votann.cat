        </profile>
        <profile id="5ce123f4" name="Enhancement: Waste Feeds the Void (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Each time a model in the bearer's unit makes a ranged attack, re-roll a Hit roll of 1. In addition, the bearer's unit is eligible to shoot in a turn in which it Fell Back. (Default enhancement; may be replaced with Prâgmaat Comms Uplink: Add 1 to the Objective Control characteristic of models in the bearer's unit. In addition, you can re-roll Battle-shock tests taken for the bearer's unit.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="ee10454f" name="Grim Efficiency" hidden="false">
          <description>Once per battle round, in your Command phase, you can select one enemy unit that is visible to this model. That enemy unit gains 1 Judgement token.</description>
        </rule>
        <rule id="4541f07f" name="Leader" hidden="false">
          <description>This model can be attached to the following unit: Hearthkyn Warriors</description>
        </rule>
        <rule id="d4105a24" name="Enhancement: Waste Feeds the Void (Warlord)" hidden="false">
          <description>Each time a model in the bearer's unit makes a ranged attack, re-roll a Hit roll of 1. In addition, the bearer's unit is eligible to shoot in a turn in which it Fell Back. (Default enhancement; may be replaced with Prâgmaat Comms Uplink: Add 1 to the Objective Control characteristic of models in the bearer's unit. In addition, you can re-roll Battle-shock tests taken for the bearer's unit.)</description>
        </rule>
      </rules>
