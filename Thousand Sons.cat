        <profile id="4d7f6c55" name="Enhancement: Temporal Sorceries (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">The bearer has the Deep Strike and Lone Operative abilities. In addition, at the end of your Command phase, if the bearer is on the battlefield, you gain D3 Cabal points. (Default enhancement; may be replaced with Arch-Diabolist: The bearer has the Deep Strike and Lone Operative abilities. In addition, both of the bearer's Screamer Invocation weapon profiles have the [PISTOL] ability.)</characteristic>
          </characteristics>
        </profile>
