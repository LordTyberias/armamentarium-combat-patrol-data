        <profile id="a1eb5121" name="Prophesied Doom" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">When this unit ends a charge move, you can select one enemy unit engaged with this unit. For each model in this unit engaged with that enemy unit, roll one D6:On a 4+, that enemy unit suffers 1 mortal wound.</characteristic>
          </characteristics>
        </profile>
