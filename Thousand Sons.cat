    <selectionEntry id="cp::the-coven-temporus::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="7b88ded9" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="2a058a3d" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="ccf6ca73" name="Combat Patrol: Thousand Sons (The Coven Temporus)" hidden="false" targetId="cp-cat::the-coven-temporus" primary="true" />
        <categoryLink id="c24dfeba" name="Thousand Sons" hidden="false" targetId="cp-faction::thousand-sons" primary="false" />
        <categoryLink id="1a1737ec" name="Chaos" hidden="false" targetId="cp-group::chaos" primary="false" />
        <categoryLink id="11b09641" name="Legacy" hidden="false" targetId="cp-flag::legacy" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="c19185c3" name="Wreathed in Warpflame" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Fight phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One THOUSAND SONS unit from your army (excluding TZAANGORS units) that has not been selected to fight this phase.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, melee weapons equipped by models in your unit have the [LETHAL HITS] ability and each time a model in your unit makes an attack that targets a MONSTER or VEHICLE unit, an unmodified Hit roll of 5+ scores a Critical Hit.</characteristic>
          </characteristics>
        </profile>
        <profile id="03376734" name="Mutant Cunning" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Shooting phase, just after an enemy unit has selected its targets.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One TZAANGORS unit from your army that was selected as the target of one or more of the attacking unit’s attacks.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit can make a Normal move of up to D6" and, until the end of the phase, each time a ranged attack targets your unit, models in your unit have the Benefit of Cover against that attack.</characteristic>
          </characteristics>
        </profile>
        <profile id="4e7bcd99" name="Malign Entanglement" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your opponent’s Charge phase, just after an enemy unit has declared a charge.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One THOUSAND SONS unit from your army that was selected as a target of that charge.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Until the end of the phase, subtract 2 from Charge rolls made for that enemy unit.</characteristic>
          </characteristics>
        </profile>
        <profile id="b9f18d44" name="Sorcerous Ritual" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Default</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">From the second battle round onwards, at the end of your opponent’s Fight phase, if one or more PSYKER models from your army are within range of an objective marker that you control and that is not within your deployment zone, roll one D6, adding 1 to the result for each remaining Cabal point you have (to a maximum of +3): on a 5+, you score 3VP</characteristic>
          </characteristics>
        </profile>
        <profile id="1e2511be" name="Bringer of Change" typeId="d3e08c92" typeName="Secondary Objective" hidden="false">
          <characteristics>
            <characteristic name="Type" typeId="31915f4c">Optional</characteristic>
            <characteristic name="Effect" typeId="53bd7dca">At the end of each phase, you score D3 VP if one or more enemy models were destroyed by Psychic Attacks made by models from your army that phase. You cannot score more than 12VP from this secondary objective.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
