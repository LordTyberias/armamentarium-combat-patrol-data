        <profile id="85e510c7" name="Enhancement: Servo-skull Dataleech (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Armiger Helverin model only. Each time the bearer destroys an enemy Character unit, roll one D6: on a 2+, you gain 1CP. (Pilot Dantos and Thauvir is the patrol's default Warlord; you may instead make Pilot Morrigan and Viridor your Warlord with the Embedded Auto Medicae enhancement.)</characteristic>
