        <profile id="8858afa3" name="Enhancement: Lord of the Pyroclasts (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">While an enemy unit is within Engagement Range of this model, subtract 1 from the Objective Control characteristic of models in that unit. (Default enhancement; may be replaced with Master of Flames: Torrent weapons equipped by models in the bearer's unit can re-roll the roll to determine the number of attacks made with that weapon.)</characteristic>
          </characteristics>
