        <profile id="3209902d" name="Litany of Hate" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">While this model is leading a unit, each time a model in that unit makes a melee attack, add 1 to the Wound roll.</characteristic>
          </characteristics>
        </profile>
        <profile id="fe1d074e" name="Leader" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">This model can be attached to the following unit: Intercessor Squad.</characteristic>
          </characteristics>
        </profile>
        <profile id="d2f4c31e" name="Enhancement: Stoic Exemplar (Warlord)" typeId="a915f3e9" typeName="Abilities" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="2451ab48">Each time a melee attack targets the bearer's unit, if one or more enemy units ended a Charge move within Engagement Range of the bearer's unit this turn, subtract 1 from the Wound roll. (Default enhancement; may be replaced with Zealous Wrath: You can re-roll Advance and Charge rolls made for the bearer's unit.)</characteristic>
          </characteristics>
        </profile>
      </profiles>
      <rules>
        <rule id="1ae93338" name="Litany of Hate" hidden="false">
          <description>While this model is leading a unit, each time a model in that unit makes a melee attack, add 1 to the Wound roll.</description>
        </rule>
        <rule id="4541f07f" name="Leader" hidden="false">
          <description>This model can be attached to the following unit: Intercessor Squad.</description>
