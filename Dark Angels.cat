    <selectionEntry id="cp::the-vengeful-brethren::0-patrol-rules" name="Patrol Rules" type="unit" hidden="false">
      <constraints>
        <constraint id="6836fb0b" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="min" />
        <constraint id="04dedb94" field="selections" scope="parent" value="0" percentValue="false" shared="true" includeChildSelections="false" includeChildForces="false" type="max" />
      </constraints>
      <categoryLinks>
        <categoryLink id="4a1cbf76" name="Combat Patrol: Dark Angels (The Vengeful Brethren)" hidden="false" targetId="cp-cat::the-vengeful-brethren" primary="true" />
        <categoryLink id="ccda3134" name="Dark Angels" hidden="false" targetId="cp-faction::dark-angels" primary="false" />
        <categoryLink id="39c24a82" name="Space Marines" hidden="false" targetId="cp-group::space-marines" primary="false" />
      </categoryLinks>
      <profiles>
        <profile id="07062a79" name="Oath of Moment" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">This ability is described in full in the Army Rules section of Codex: Space Marines.</characteristic>
          </characteristics>
        </profile>
        <profile id="e2c1b730" name="The Deathwing" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">The following ADEPTUS ASTARTES units gain the DEATHWING keyword if they are drawn from the Dark Angels Chapter: ■ TERMINATOR units ■ BLADEGUARD ANCIENT, BLADEGUARD VETERAN SQUAD, STERNGUARD VETERAN SQUAD and VANGUARD VETERAN SQUAD WITH JUMP PACKS units ■ LAND RAIDER, LAND RAIDER CRUSADER, LAND RAIDER REDEEMER, REPULSOR and REPULSOR EXECUTIONER units ■ DREADNOUGHT units</characteristic>
          </characteristics>
        </profile>
        <profile id="ee9fe501" name="The Ravenwing" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">The following ADEPTUS ASTARTES units gain the RAVENWING keyword if they are drawn from the Dark Angels Chapter: ■ MOUNTED units ■ VEHICLE units that can FLY</characteristic>
          </characteristics>
        </profile>
        <profile id="43398f52" name="The Unforgiven" typeId="7a1e5c04" typeName="Army Rule" hidden="false">
          <characteristics>
            <characteristic name="Description" typeId="a1d33e77">■ If an ADEPTUS ASTARTES unit has a second Faction keyword on its datasheet, that Faction keyword is the name of that unit’s Chapter. For example, Asmodai has both the ADEPTUS ASTARTES and DARK ANGELS Faction keywords, and is therefore from the Dark Angels Chapter. ■ You cannot include units from more than one Chapter in your army. Designer’s Note: The rules presented in this section assume that the ADEPTUS ASTARTES units in your army are from the Dark Angels Chapter, but they can also be used to represent any Dark Angels successor Chapter, such as one described in the background section of this book, or even one of your own invention. However, players who wish to faithfully recreate the Dark Angels Chapter on the tabletop should only include DARK ANGELS EPIC HEROES if their collection is intended to represent the First Founding Chapter itself; Ezekiel is the Chief Librarian of the Dark Angels, for example, and not of any of their successors.</characteristic>
          </characteristics>
        </profile>
        <profile id="755645b0" name="Honoured Knights" typeId="3f92bd18" typeName="Detachment" hidden="false">
          <characteristics>
            <characteristic name="DP" typeId="5b7c1e90">1DP</characteristic>
            <characteristic name="Rule" typeId="e8340af2">When an enemy unit ends a charge move, friendly VENGEFUL BRETHREN units engaged with that enemy unit are in defence stance until the end of the turn:While a unit is in defence stance, attacks that target that unit with a S greater than that unit's T have -1 to wound rolls.</characteristic>
            <characteristic name="Force Disposition" typeId="9c61d5b4">Take and Hold</characteristic>
          </characteristics>
        </profile>
        <profile id="76620d2d" name="Supreme Combatant" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">VENGEFUL BRETHREN GRAVIS CAPTAIN model only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">When this unit is selected to attack, this unit's attacks have:[LETHAL HITS].Or: [SUSTAINED HITS 1].</characteristic>
          </characteristics>
        </profile>
        <profile id="fc2680c3" name="Dutiful Defenders" typeId="c05a7e6b" typeName="Enhancement" hidden="false">
          <characteristics>
            <characteristic name="Restriction" typeId="2d84f0c1">VENGEFUL BRETHREN BLADEGUARD VETERAN SQUAD unit only.</characteristic>
            <characteristic name="Effect" typeId="b7e95a36">(Once per battle round, per army) When you target this unit with the Heroic Intervention stratagem, that use is -1 CP.</characteristic>
          </characteristics>
        </profile>
        <profile id="d50273c0" name="For the Lion" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Command phase.</characteristic>
            <characteristic name="Target" typeId="459fde7d">One friendly VENGEFUL BRETHREN unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit has +1 OC until the end of the turn.</characteristic>
          </characteristics>
        </profile>
        <profile id="d2c11e5c" name="Mission Focus" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Your Shooting phase or the Fight phase, when a friendly VENGEFUL BRETHREN unit within range of an objective is selected to attack.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That VENGEFUL BRETHREN unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">Your unit's attacks have +1 to hit rolls.</characteristic>
          </characteristics>
        </profile>
        <profile id="abfdb3f3" name="Determined to the Last" typeId="cf5a1b7e" typeName="Stratagem" hidden="false">
          <characteristics>
            <characteristic name="CP" typeId="8000e444">1CP</characteristic>
            <characteristic name="When" typeId="1cfae44d">Fight phase, when an enemy unit targets a friendly VENGEFUL BRETHREN BLADEGUARD VETERAN SQUAD unit.</characteristic>
            <characteristic name="Target" typeId="459fde7d">That VENGEFUL BRETHREN BLADEGUARD VETERAN SQUAD unit.</characteristic>
            <characteristic name="Effect" typeId="abf47a40">When a model in your unit is destroyed, if your unit has not been selected to fight this phase, roll one D6:On a 2+, do not remove that model from the battlefield. When your unit has fought, or at the end of the phase (whichever comes first), that model is removed from the battlefield.</characteristic>
          </characteristics>
        </profile>
      </profiles>
    </selectionEntry>
